# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form enquiries
CONTACT_TO=support@a3techgroup.com

# "From" address. Must use a domain verified in Resend.
CONTACT_FROM=RemoCollab <noreply@a3techgroup.com>
